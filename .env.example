SECRET_KEY=troque-esta-chave-super-secreta
# DATABASE_URL usa caminho absoluto padrão do config.py — deixe comentado ou ajuste:
# DATABASE_URL=sqlite:///C:/caminho/absoluto/instance/rdrimports.db

# Admin padrão — OBRIGATÓRIO trocar antes de publicar!
ADMIN_EMAIL=admin@rdrimports.com
ADMIN_PASSWORD=troque-esta-senha-admin

# Mercado Pago — gere em https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI
MP_PUBLIC_KEY=SUA_PUBLIC_KEY_AQUI

# URL pública do site (necessária para webhooks do Mercado Pago)
BASE_URL=http://localhost:5000

# Modo debug: 1 = ativo (dev), 0 = desativado (produção)
FLASK_DEBUG=1
